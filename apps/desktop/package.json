{
  "name": "@showpilot/desktop",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "bridge:prepare": "pnpm --filter @showpilot/bridge build",
    "bridge:build": "node scripts/build-bridge.mjs",
    "test:offline": "pnpm --filter @showpilot/bridge build && node --test scripts/offline-shell.test.mjs && node --check offline/offline.js",
    "desktop:dev": "pnpm bridge:build && tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "bun": "1.4.4",
    "jsdom": "31.0.1"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.30.3 <11"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ShowPilot's trusted web app and bundled development UI may access the desktop engine.",
  "windows": [
    "main",
    "timer-*",
    "show-board-*",
    "confidence-*",
    "check-in-*"
  ],
  "remote": {
    "urls": [
      "https://showpilot.tech/*",
      "https://app.showpilot.tech/*"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "updater:default",
    "allow-desktop-controls"
  ]
}

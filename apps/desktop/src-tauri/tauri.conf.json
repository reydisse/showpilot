{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShowPilot Desktop",
  "version": "0.1.1",
  "identifier": "tech.showpilot.desktop",
  "build": {
    "beforeDevCommand": "pnpm -C ../web exec vite dev --port 3001 --strictPort",
    "beforeBuildCommand": "pnpm bridge:build",
    "devUrl": "http://localhost:3001",
    "frontendDist": "https://showpilot.tech"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ShowPilot Desktop",
        "width": 1500,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#090a0b",
        "userAgent": "ShowPilotDesktop/0.1.1"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/showpilot-bridge"],
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "ShowPilot production control for desktop",
    "longDescription": "The complete ShowPilot production workspace with native local-engine, offline snapshot and dedicated output-window capabilities.",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNjgyQUY5NUU2QTQwOTkKUldTWlFHcGUrU3BvLzY5cUdieDNhdk9MeWhVcjhybU1BRURVbUNuZmhkbG1ZRTFHVlZjS3Z6NkIK",
      "endpoints": [
        "https://www.showpilot.tech/updates/desktop/latest.json"
      ]
    }
  }
}

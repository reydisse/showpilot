
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  orgMembers    OrgMember[]
  invitations   Invitation[]
  dashboardLayouts DashboardLayout[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  cloud_enabled Boolean    @default(true)
  createdAt   DateTime
  metadata    String?

  // Billing (Stripe) — effective plan is resolved by getEffectivePlan()
  // in src/lib/plan-limits.ts (beta > trial > plan precedence).
  plan                 String    @default("free") // "free" | "starter" | "pro"
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?   // mirrors Stripe subscription status
  trialEndsAt          DateTime?
  foundingMember       Boolean   @default(false)
  betaTester           Boolean   @default(false)

  members     Member[]
  orgMembers  OrgMember[]
  invitations Invitation[]

  // App relations
  crewMembers        CrewMember[]
  serviceAssignments ServiceAssignment[]
  checklistTemplates ChecklistTemplate[]
  checklistEntries   ChecklistEntry[]
  cueSheets          CueSheet[]
  cueColumns         CueColumn[]
  incidents          Incident[]
  micAssignments     MicAssignment[]
  equipment          Equipment[]
  notifications      Notification[]
  devices            Device[]
  appSettings        AppSetting[]
  rundowns           Rundown[]
  rundownItems       RundownItem[]
  graphicTemplates   GraphicTemplate[]
  streamDestinations StreamDestination[]
  liveInputs         LiveInput[]
  chatMessages       ChatMessage[]
  dashboardLayouts   DashboardLayout[]
  kioskTokens        KioskToken[]
  companionTokens    CompanionToken[]

  organizationroles OrganizationRole[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model OrgMember {
  id           String       @id
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role         Role

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("org_member")
}

enum Role {
  owner
  admin
  pm
  tm
  sm
  member
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ─── App Models ──────────────────────────────────────────────

model CrewMember {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberId     String
  name         String
  role         String
  email        String       @default("")
  photoUrl     String       @default("")
  isOnline     Boolean      @default(false)
  lastCheckIn  DateTime?
  lastCheckOut DateTime?
  createdAt    DateTime     @default(now())
  assignments  ServiceAssignment[]

  @@unique([orgId, memberId])
  @@index([orgId, name])
  @@index([orgId, email])
  @@map("crew_member")
}

model ChecklistTemplate {
  id           String           @id @default(cuid())
  orgId        String
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label        String
  category     String // audio | video | stream | lighting | general
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  entries      ChecklistEntry[]

  @@index([orgId, sortOrder])
  @@map("checklist_template")
}

model ChecklistEntry {
  id           String            @id @default(cuid())
  orgId        String
  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId   String
  template     ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  serviceDate  String
  checked      Boolean           @default(false)
  checkedBy    String?
  checkedAt    DateTime?

  @@index([orgId, serviceDate])
  @@index([templateId])
  @@map("checklist_entry")
}

model CueSheet {
  id                String       @id @default(cuid())
  orgId             String
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cueNumber         Int
  rundownItem       String
  cameraAssignments String       @default("")
  notes             String       @default("")
  serviceDate       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([orgId, serviceDate])
  @@map("cue_sheet")
}

/// A department column on the cue sheet — Production, Pro Ops, LX, SM.
/// Columns are data, not code: every org names its departments
/// differently and adds one the week it hires someone new.
model CueColumn {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label        String
  /// Header tint. Stored as a key into a fixed palette, not a hex, so
  /// the dark theme stays coherent and contrast is guaranteed.
  color        String       @default("slate")
  sortOrder    Int          @default(0)
  /// Persisted pixel width from the column resizer.
  width        Int          @default(160)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  notes        CueNote[]

  @@index([orgId, sortOrder])
  @@map("cue_column")
}

/// One cell: what a department has to do on one rundown item, for one
/// service. Keyed by the rundown item's stable itemId rather than a row
/// of its own, so the cue sheet can never drift from the rundown.
model CueNote {
  id          String    @id @default(cuid())
  orgId       String
  serviceDate String
  itemId      String
  columnId    String
  column      CueColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  text        String    @default("")
  updatedAt   DateTime  @updatedAt
  updatedBy   String    @default("")

  @@unique([orgId, serviceDate, itemId, columnId])
  @@index([orgId, serviceDate])
  @@map("cue_note")
}

model DashboardLayout {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboard    String
  layout       String
  updatedAt    DateTime     @updatedAt

  @@unique([orgId, userId, dashboard])
  @@map("dashboard_layout")
}

model Incident {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category     String // audio | video | stream | lighting | other
  severity     String // low | medium | high
  description  String
  reportedBy   String
  serviceDate  String
  timestamp    DateTime     @default(now())
  // Lifecycle. Without it nothing carries forward between services.
  status       String       @default("open") // open | resolved
  resolvedAt   DateTime?
  resolvedBy   String?
  /// Who is on it. An unowned fault is the one that gets dropped —
  /// two techs both grabbing the same problem, or nobody grabbing it,
  /// is the failure mode a tech team actually has.
  assignedTo   String?
  /// Denormalised for display. The dashboard renders a name on every
  /// fault row and joining out to `user` for each one, on a page that
  /// re-reads every twenty seconds during a service, is not worth it.
  assignedName String       @default("")
  acknowledgedAt DateTime?
  assignedBy   String?
  assignedAt   DateTime?

  @@index([orgId, serviceDate])
  @@index([orgId, status])
  @@index([orgId, assignedTo])
  @@map("incident")
}

/// One position on one service. A null crewMemberId is an open slot —
/// the thing a production manager most needs to see before Sunday.
model ServiceAssignment {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serviceDate  String
  crewMemberId String?
  crewMember   CrewMember?  @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)
  role         String
  status       String       @default("assigned") // assigned | confirmed | declined
  notes        String       @default("")
  invitedAt    DateTime?
  respondedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId, serviceDate])
  @@index([crewMemberId])
  @@map("service_assignment")
}

model MicAssignment {
  id               String       @id @default(cuid())
  orgId            String
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel          Int
  label            String
  micType          String // wireless-handheld | wireless-lav | wired | headset | di-box | other
  micModel         String       @default("")
  notes            String       @default("")
  gainDb           Float?
  phantom          Boolean      @default(false)
  muted            Boolean      @default(false)
  group            String       @default("other") // vocals | band | playback | sfx | other
  mixerConsole     String       @default("")
  mixerChannel     Int?
  mixerChannelType String       @default("")
  serviceDate      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orgId, serviceDate])
  @@map("mic_assignment")
}

model Equipment {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  category     String // audio | video | lighting | streaming | comms | other
  status       String       @default("operational") // operational | needs-repair | out-of-service | in-repair
  location     String       @default("")
  serialNumber String       @default("")
  notes        String       @default("")
  lastServiced DateTime?
  nextService  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId])
  @@map("equipment")
}

model Notification {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type         String
  severity     String       @default("info") // info | warning | critical
  title        String
  message      String
  target       String       @default("all") // all | tech-manager | audio | production-manager | show
  source       String       @default("")
  createdAt    DateTime     @default(now())
  dismissed    Boolean      @default(false)

  @@index([orgId, createdAt(sort: Desc)])
  @@map("notification")
}

model Device {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  category     String // mixer | streaming | timer | automation | video | comms
  adapterType  String       @default("")
  settings     String       @default("{}") // JSON string
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId])
  @@map("device")
}

model AppSetting {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key          String
  value        String

  @@unique([orgId, key])
  @@map("app_setting")
}

model RundownItem {
  id           String   @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serviceDate  String
  itemId       String
  title        String
  type         String
  duration     Int
  notes        String
  assignee     String
  cue          String
  status       String
  sortOrder    Int
  hardStop       Boolean   @default(false)
  lowerThirdId   String?
  scheduledStart DateTime?
  expectedEnd    DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([orgId, serviceDate, itemId])
  @@index([orgId, serviceDate, sortOrder])
  @@index([orgId, serviceDate])
  @@map("rundown_item")
}

model Rundown {
  id                 String       @id @default(cuid())
  orgId              String
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serviceDate        String
  /// Optional label, e.g. "Christmas Eve 7pm". Empty for a regular service.
  name               String       @default("")
  scheduledStartTime DateTime?
  status             String       @default("stopped")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([orgId, serviceDate])
  @@index([orgId, serviceDate])
  @@map("rundown")
}

model GraphicTemplate {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  title        String
  subtitle     String       @default("")
  style        String       @default("{}") // JSON: font, colors, position, animation
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId])
  @@map("graphic_template")
}

model StreamDestination {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  platform     String // youtube | facebook | twitch | custom
  rtmpUrl      String       @default("")
  streamKey    String       @default("")
  enabled      Boolean      @default(true)
  cfOutputId   String       @default("") // Cloudflare Stream Connect output ID
  liveInputId  String       @default("") // Which live input this is connected to
  createdAt    DateTime     @default(now())

  @@index([orgId])
  @@map("stream_destination")
}

model LiveInput {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cfInputId    String       @default("")
  cfInputUid   String       @default("")
  name         String
  rtmpUrl      String       @default("")
  rtmpKey      String       @default("")
  srtUrl       String       @default("")
  status       String       @default("idle") // idle | connected | streaming
  createdAt    DateTime     @default(now())

  @@unique([orgId, cfInputId])
  @@index([orgId])
  @@map("live_input")
}

model KioskToken {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label        String // e.g. "Stage Timer", "Confidence Monitor"
  view         String // route/view scoped to: timer | overlay | board
  token        String       @unique // signed JWT string
  expiresAt    DateTime? // null = permanent
  createdBy    String // userId who created it
  revokedAt    DateTime? // null = active
  createdAt    DateTime     @default(now())

  @@index([orgId])
  @@index([token])
  @@map("kiosk_token")
}

model CompanionToken {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label        String // e.g. "Booth Stream Deck", "FOH iPad"
  token        String       @unique // signed JWT string, prefixed `cmp_`
  expiresAt    DateTime? // null = permanent
  createdBy    String // userId who created it
  revokedAt    DateTime? // null = active
  createdAt    DateTime     @default(now())

  @@index([orgId])
  @@index([token])
  @@map("companion_token")
}

model ChatMessage {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  message      String
  senderName   String
  senderRole   String?
  createdAt    DateTime     @default(now())

  @@index([orgId, createdAt(sort: Desc)])
  @@map("chat_message")
}

// Platform-level (cross-org) settings, e.g. publicLaunchDate.
// AppSetting is org-scoped with a required FK, so platform flags
// live in their own table.
model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("platform_setting")
}

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  role      String   @default("")
  orgName   String   @default("")
  createdAt DateTime @default(now())

  @@map("waitlist_signup")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

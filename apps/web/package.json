{
  "name": "@showpilot/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "node scripts/verify-client-boundaries.mjs && vite build && node scripts/sanitize-build-output.mjs",
    "preview": "pnpm build && vite preview",
    "test": "pnpm run test:migration-manifest && pnpm run test:client-boundaries && pnpm run test:coverage-gate && pnpm run test:unit && pnpm run test:worker",
    "test:client-boundaries": "node --test scripts/query-hygiene.test.mjs scripts/client-button-names.test.mjs scripts/rundown-chat-boundary.test.mjs scripts/rundown-live-output-boundary.test.mjs scripts/timecode-continuity-boundary.test.mjs scripts/song-device-boundary.test.mjs scripts/notification-preferences-boundary.test.mjs scripts/personal-assignment-boundary.test.mjs scripts/request-polling-boundary.test.mjs scripts/time-hydration-boundary.test.mjs scripts/saved-template-storage-boundary.test.mjs scripts/template-studio-boundary.test.mjs && node scripts/verify-lyrics-spec.mjs",
    "test:migration-manifest": "node --test scripts/check-production-migrations.test.mjs",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "prisma generate",
    "db:migrate": "pnpm run db:migrate:local",
    "db:migrate:local": "node scripts/run-local-migrations.mjs",
    "db:audit-production-manifest": "node scripts/check-production-migrations.mjs --allow-pending",
    "db:check-production-manifest": "node scripts/check-production-migrations.mjs",
    "test:coverage-gate": "node --test scripts/check-coverage.test.mjs",
    "test:coverage": "pnpm run test:migration-manifest && pnpm run test:client-boundaries && pnpm run test:coverage-gate && node scripts/run-coverage.mjs",
    "coverage:ratchet": "pnpm run test:coverage && node scripts/check-coverage.mjs --ratchet"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.27",
    "@cloudflare/vite-plugin": "1.70.1",
    "@noble/hashes": "2.4.0",
    "@prisma/adapter-d1": "7.10.1",
    "@prisma/client": "7.10.1",
    "@showpilot/shared": "workspace:*",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "@tanstack/react-virtual": "3.14.27",
    "@tanstack/router-plugin": "1.169.0",
    "@tauri-apps/plugin-notification": "2.8.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "better-auth": "1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "pdfmake": "^0.3.15",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "web-push": "^4.0.0",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-istanbul": "5.1.1",
    "istanbul-lib-coverage": "3.2.2",
    "jsdom": "^31.0.1",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1",
    "wrangler": "4.166.0",
    "@tanstack/react-router-devtools": "1.167.4"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.30.3 <11"
  }
}

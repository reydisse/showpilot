{
	"name": "@showpilot/web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "node scripts/verify-client-boundaries.mjs && vite build && node scripts/sanitize-build-output.mjs",
		"preview": "pnpm build && vite preview",
		"test": "pnpm run test:migration-manifest && pnpm run test:client-boundaries && pnpm run test:unit && pnpm run test:worker",
		"test:client-boundaries": "node --test scripts/client-button-names.test.mjs",
		"test:migration-manifest": "node --test scripts/check-production-migrations.test.mjs",
		"test:unit": "vitest run",
		"test:worker": "vitest run --config vitest.worker.config.ts",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:generate": "prisma generate",
		"db:migrate": "pnpm run db:migrate:local",
		"db:migrate:local": "node scripts/run-local-migrations.mjs",
		"db:audit-production-manifest": "node scripts/check-production-migrations.mjs --allow-pending",
		"db:check-production-manifest": "node scripts/check-production-migrations.mjs"
	},
	"dependencies": {
		"@showpilot/shared": "workspace:*",
		"@better-auth/expo": "1.7.2",
		"@cloudflare/vite-plugin": "1.54.1",
		"@prisma/adapter-d1": "7.10.0",
		"@prisma/client": "7.10.0",
		"@stripe/react-stripe-js": "^6.6.0",
		"@stripe/stripe-js": "^9.8.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-query": "5.102.7",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-router-ssr-query": "1.167.2",
		"@tanstack/react-start": "1.168.49",
		"@tanstack/router-plugin": "1.168.35",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"better-auth": "1.7.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"framer-motion": "^12.33.0",
		"lucide-react": "^0.545.0",
		"pdfmake": "^0.3.8",
		"qrcode.react": "^4.2.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"stripe": "^22.2.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"web-push": "^3.6.7",
		"write-excel-file": "4.1.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.0",
		"@cloudflare/workers-types": "5.20260827.1",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.2.0",
		"@types/node": "^22.19.13",
		"@types/pdfmake": "^0.3.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/web-push": "^3.6.4",
		"@vitejs/plugin-react": "^5.0.4",
		"jsdom": "^27.0.0",
		"prisma": "7.10.0",
		"shadcn": "^3.8.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.7.2",
		"vite": "7.3.6",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.11",
		"wrangler": "4.127.0"
	}
}
